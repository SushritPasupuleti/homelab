# Example environment overrides for the homelab stack
# Copy to .env and edit before running deploy.sh if needed.

NAMESPACE=homelab
STOCK_EZ_IMAGE=ghcr.io/sushritpasupuleti/stock-ez:latest
OLLAMA_IMAGE=ollama/ollama:latest
DASHBOARD_IMAGE=nginx:alpine
PORTAINER_IMAGE=portainer/portainer-ce:latest
DOMAIN=homelab.local
STOCK_EZ_HOST=stock-ez.homelab.local
DASHBOARD_HOST=dashboard.homelab.local
PORTAINER_HOST=portainer.homelab.local
OLLAMA_HOST=ollama.homelab.local
