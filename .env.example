# Example environment overrides for the homelab stack
# Copy to .env and edit before running deploy.sh if needed.

NAMESPACE=homelab
STOCK_EZ_IMAGE=stock-ez:local
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_USE_NVIDIA=true
OLLAMA_GPU_COUNT=1
DASHBOARD_IMAGE=ghcr.io/gethomepage/homepage:latest
PORTAINER_IMAGE=portainer/portainer-ce:latest
HOME_ASSISTANT_IMAGE=ghcr.io/home-assistant/home-assistant:stable
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
NETDATA_IMAGE=netdata/netdata:stable
DOMAIN=homelab.home.arpa
STOCK_EZ_HOST=stock-ez.homelab.home.arpa
DASHBOARD_HOST=dashboard.homelab.home.arpa
PORTAINER_HOST=portainer.homelab.home.arpa
HOMEASSISTANT_HOST=homeassistant.homelab.home.arpa
OPEN_WEBUI_HOST=open-webui.homelab.home.arpa
NETDATA_HOST=netdata.homelab.home.arpa
OLLAMA_HOST=ollama.homelab.home.arpa
JELLYFIN_HOST=media.homelab.home.arpa
PLEX_HOST=plex.homelab.home.arpa
METALLB_ENABLED=true
METALLB_IP_POOL=192.168.1.200-192.168.1.249
HOMEPAGE_ALLOWED_HOSTS=dashboard.homelab.home.arpa,stock-ez.homelab.home.arpa,portainer.homelab.home.arpa,homeassistant.homelab.home.arpa,open-webui.homelab.home.arpa,netdata.homelab.home.arpa,ollama.homelab.home.arpa,media.homelab.home.arpa,plex.homelab.home.arpa,localhost,127.0.0.1,192.168.1.201,192.168.1.202,192.168.1.203,192.168.1.205,192.168.1.207,192.168.1.208,192.168.1.209,192.168.1.210,192.168.1.6,::1
